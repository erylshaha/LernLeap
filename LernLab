<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LernLab – LernLeap mit MEo</title>
<script>try{var t=localStorage.getItem('ll-theme');if(!t||t==='system')t=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.dataset.theme=t}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ===== tokens (aus index.html übernommen) ===== */
:root{
  --bg:#FAF8F3;--surface:#FFFFFF;--text:#252525;--muted:#5C5C5C;--line:#D8D3C8;
  --blue:#003468;--green:#A5C500;--on-green:#252525;--plum:#810061;--orange:#EC6400;
  --wm:#003468;--focus:#003468;--yarn:#AA2620;
  --s1:4px;--s2:8px;--s3:16px;--s4:24px;--s5:32px;--s6:48px;--s7:64px;--s8:96px;
  --serif:"Libre Baskerville",Baskerville,"Times New Roman",serif;
  --sans:Inter,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;
  --ease:cubic-bezier(.2,.7,.2,1);--t1:120ms;--t2:240ms;--hh:64px;--wrap:1320px;--r:2px;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
:root[data-theme="dark"]{
  --bg:#0B1624;--surface:#12233A;--text:#EEEBE4;--muted:#A7B2C0;--line:#2B3F5A;
  --blue:#8DB6E8;--plum:#E3A0D2;--orange:#FF8A3D;--wm:#F3EFE6;--focus:#A5C500;color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:calc(var(--hh) + 16px)}
body{margin:0;background:var(--bg);color:var(--text);font:400 16px/1.55 var(--sans);-webkit-font-smoothing:antialiased}
h1,h2,h3,p,dl,dd,ul{margin:0;padding:0}ul{list-style:none}a{color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:3px}
.muted{color:var(--muted)}
.btn{display:inline-block;padding:12px 24px;background:var(--green);color:var(--on-green);font:600 15px/1.2 var(--sans);border:1px solid var(--text);border-radius:var(--r);cursor:pointer}
.btn[aria-disabled="true"]{background:transparent;color:var(--muted);border-color:var(--line);cursor:not-allowed}
.ibtn{display:flex;align-items:center;gap:var(--s2);height:40px;padding:0 12px;background:none;border:1px solid var(--line);color:var(--text);font:500 14px var(--sans);cursor:pointer;border-radius:var(--r)}
.ibtn:hover{border-color:var(--text)}
.pop{position:absolute;right:0;top:calc(100% + 12px);width:min(320px,calc(100vw - 32px));background:var(--surface);border:1px solid var(--line);padding:var(--s4);z-index:70}
.pop[hidden],.ddp[hidden],.hd-more[hidden]{display:none}
.pop fieldset{border:0;margin:0;padding:0}.pop legend{font:600 13px var(--sans);color:var(--muted);padding:0;margin-bottom:var(--s2)}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s2)}.seg label{position:relative}
.seg input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.seg span{display:block;text-align:center;padding:10px 8px;border:1px solid var(--line);font-weight:500;font-size:15px}
.seg input:checked+span{border:2px solid var(--blue);font-weight:600;color:var(--blue);padding:9px 7px}
.seg input:focus-visible+span{outline:3px solid var(--focus);outline-offset:2px}

/* ===== header (wie index.html) ===== */
.hd{position:sticky;top:0;z-index:50;background:var(--bg);border-bottom:1px solid var(--line)}
.hd-in{max-width:var(--wrap);margin:auto;padding:0 24px;height:var(--hh);display:flex;align-items:center;gap:var(--s3)}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo-ball{width:28px;height:28px;flex:none}
.logo-wm{font:700 22px/1 var(--serif);color:var(--wm);letter-spacing:-.01em}
.logo-sub{font:italic 400 14px/1 var(--serif);color:var(--muted)}
.gchip{border:1px dashed var(--yarn)}.gchip .dot{width:10px;height:10px;border-radius:50%;background:var(--yarn)}
.streak{display:inline-flex;align-items:center;gap:6px;font:500 14px var(--sans);color:var(--muted)}.streak svg{color:var(--yarn)}
.nav{display:flex;gap:var(--s1);margin:0 auto;align-items:center}
.nav>a,.ddb{padding:8px 12px;text-decoration:none;font:500 15px var(--sans);color:var(--text);border:0;border-bottom:2px solid transparent;background:none;cursor:pointer;display:flex;align-items:center;gap:6px}
.nav>a:hover,.ddb:hover{border-color:var(--line)}
.nav [aria-current="true"]{border-color:var(--blue);color:var(--blue)}
.dd{position:static}
.ddp{position:absolute;left:50%;top:100%;transform:translateX(-50%);width:min(380px,calc(100vw - 32px));padding:var(--s4);background:var(--surface);border:1px solid var(--line);border-top:0;z-index:70}
.ddh{font:600 12px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 var(--s2)}
.ddp a{display:block;padding:12px 0;border-top:1px solid var(--line);text-decoration:none}.ddp a:hover b{color:var(--blue)}
.ddp b{font-weight:600}.ddp span.d{display:block;font-size:13px;color:var(--muted)}
.hd-r{display:flex;align-items:center;gap:var(--s2);position:relative}
.soon-b{display:inline-block;margin-left:8px;padding:1px 8px;border:1px solid var(--yarn);color:var(--yarn);font-size:12px;font-weight:600}
:root[data-theme="dark"] .soon-b{color:#F0716A;border-color:#F0716A}
.hd-more{border-top:1px solid var(--line)}.hd-more-in{max-width:var(--wrap);margin:auto;padding:0 24px;min-height:48px;display:flex;align-items:center;justify-content:center;gap:var(--s4);flex-wrap:wrap}
.hd-more a{font:500 14px var(--sans);text-decoration:none}.hd-more a:hover{text-decoration:underline;text-decoration-color:var(--yarn);text-underline-offset:5px}

/* ===== LernLab layout ===== */
.lab{max-width:var(--wrap);margin:0 auto;padding:var(--s5) 24px var(--s7);display:grid;grid-template-columns:minmax(0,1fr) 340px;column-gap:var(--s5)}
.lab-main{min-width:0}
.crumb{font-size:14px;color:var(--muted)}
.cats{display:flex;gap:var(--s1);border-bottom:1px solid var(--line);margin-bottom:var(--s4);overflow-x:auto}
.cats button,.games button{background:none;border:0;border-bottom:2px solid transparent;padding:10px 14px;font:500 15px var(--sans);color:var(--text);cursor:pointer;white-space:nowrap}
.cats button:hover,.games button:hover{border-color:var(--line)}
.cats button[aria-selected="true"],.games button[aria-selected="true"]{border-color:var(--blue);color:var(--blue);font-weight:600}
.cats button:disabled{color:var(--muted);cursor:not-allowed}
.games{display:flex;gap:var(--s1);margin-bottom:var(--s5);overflow-x:auto}
.titlebar{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--s3);flex-wrap:wrap}
.disp{font:700 clamp(32px,4vw,48px)/1.1 var(--serif);letter-spacing:-.01em;color:var(--wm)}
.disp small{font:400 14px var(--sans);color:var(--muted);letter-spacing:0;margin-left:8px}
.tag{margin-top:var(--s2);color:var(--blue);font-weight:600}
.meta{display:flex;align-items:center;gap:var(--s3);font-size:14px;color:var(--muted)}
.filters{display:flex;flex-wrap:wrap;gap:var(--s2) var(--s4);align-items:center;margin:var(--s4) 0}
.fgroup{display:flex;align-items:center;gap:var(--s2);flex-wrap:wrap}
.fl{font-size:13px;font-weight:600;color:var(--muted);margin-right:4px}
.chip{border:1px solid var(--line);background:none;color:var(--text);padding:6px 14px;font:500 14px var(--sans);cursor:pointer;border-radius:var(--r)}
.chip:hover{border-color:var(--text)}
.chip[aria-pressed="true"]{background:var(--green);color:var(--on-green);border-color:var(--on-green);font-weight:600}

/* Spielfläche (Platzhalter) */
.stage{position:relative;border:1px dashed var(--muted);background:var(--surface);aspect-ratio:16/8;min-height:340px;display:flex;flex-direction:column}
.st-top{display:flex;justify-content:space-between;padding:var(--s3)}
.pill{border:1px solid var(--line);padding:4px 12px;font:500 14px var(--sans);background:var(--bg);font-variant-numeric:tabular-nums}
.st-mid{flex:1;display:grid;place-items:center;text-align:center;padding:0 var(--s3)}
.st-mid p{max-width:46ch}
.slots{display:flex;justify-content:space-around;gap:var(--s3);padding:0 var(--s5) var(--s3)}
.slot{width:min(150px,28%);height:56px;border:1px dashed var(--line);display:grid;place-items:center;font-size:13px;color:var(--muted)}
.st-hint{margin:0 var(--s3) var(--s3);padding:10px var(--s3);border:1px solid var(--line);background:var(--bg);text-align:center;font-size:15px}
.answer{display:flex;gap:var(--s2);margin-top:var(--s3)}
.answer input{flex:1;font:inherit;padding:12px var(--s3);border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:var(--r)}
.answer input:disabled{opacity:.7}
.start-row{display:flex;gap:var(--s3);align-items:center;margin-top:var(--s4);flex-wrap:wrap}

/* Sidebar */
.side{display:flex;flex-direction:column;gap:var(--s5)}
.panel h2{font:600 12px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:var(--s3)}
.rings{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s3) var(--s2)}
.ring{text-align:center;font-size:13px;color:var(--muted)}
.ring i{--p:0;display:grid;place-items:center;width:64px;height:64px;margin:0 auto 4px;border-radius:50%;font:600 14px var(--sans);font-style:normal;color:var(--text);background:conic-gradient(var(--yarn) calc(var(--p)*1%),var(--line) 0);position:relative}
.ring i::before{content:"";position:absolute;inset:5px;background:var(--bg);border-radius:50%}
.ring i span{position:relative}
.words{display:flex;flex-direction:column}
.words-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--s2)}
.w{padding:var(--s3) 0;border-top:1px solid var(--line)}
.w-top{display:flex;justify-content:space-between;gap:var(--s2);align-items:baseline}
.w-top b{font:700 18px var(--serif);color:var(--wm)}.w-top em{font:italic 400 13px var(--serif);color:var(--muted);margin-left:6px}
.lvl{font-size:12px;font-weight:600;border:1px solid var(--line);padding:1px 8px;color:var(--muted)}
.w p{font-size:14px;margin-top:4px}.w .ex{font-style:italic;color:var(--muted)}
.w .act{margin-top:var(--s2);display:flex;gap:var(--s2)}
.w .act button{border:1px solid var(--line);background:none;color:var(--text);font:500 12px var(--sans);padding:3px 10px;cursor:pointer;border-radius:var(--r)}
.w .act button:hover{border-color:var(--text)}
.link{font-weight:600;color:var(--blue);text-underline-offset:6px;text-decoration-thickness:2px;text-decoration-color:var(--yarn);font-size:14px}

.ft{max-width:var(--wrap);margin:0 auto;padding:var(--s5) 24px var(--s6);border-top:1px solid var(--line);display:flex;justify-content:space-between;flex-wrap:wrap;gap:var(--s3);font-size:15px}
.ft .logo-wm{font-size:20px}

@media(max-width:1020px){.lab{grid-template-columns:1fr}.nav{display:none}.hd-in{gap:var(--s2)}.hd-r{margin-left:auto}.logo-sub{display:none}}
@media(max-width:600px){.hd-in,.lab{padding-left:16px;padding-right:16px}.logo-wm{display:none}.ibtn span{display:none}.stage{aspect-ratio:auto;min-height:380px}.slots{flex-direction:column;align-items:center}.slot{width:70%}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
/* ===== v2: gemeinsame Bühne (alles Spielrelevante liegt IN der Bühne) ===== */
html.nos,html.nos body{overflow:hidden}
.mod[hidden]{display:none}
.lab[data-mod]:not([data-mod="vocab"]),.lab.wide{grid-template-columns:minmax(0,1fr)}
.lab[data-mod]:not([data-mod="vocab"]) .side,.lab.wide .side{display:none}
.lab.wide{max-width:none}
.sm{font-size:13px}
.stg{position:relative;border:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column;height:min(720px,calc(100dvh - 190px));min-height:460px;overflow:hidden}
.stg.full{position:fixed;inset:0;z-index:200;height:100dvh;min-height:0;border:0;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.sb{display:flex;align-items:center;gap:var(--s2);padding:var(--s2) 12px;border-bottom:1px solid var(--line);min-height:52px;flex:none}
.sb .t{font:700 16px/1.2 var(--serif);color:var(--wm);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ex{display:flex;gap:var(--s1);flex:none}
.sbtn{height:40px;min-width:40px;padding:0 10px;background:none;border:1px solid var(--line);color:var(--text);font:500 14px var(--sans);cursor:pointer;border-radius:var(--r);white-space:nowrap}
.sbtn:hover,.sbtn[aria-pressed="true"],.sbtn[aria-expanded="true"]{border-color:var(--blue);color:var(--blue)}
.pbar{height:4px;background:var(--line);flex:none}.pbar i{display:block;height:100%;width:0;background:var(--green);transition:width var(--t2) var(--ease)}
.sbody{flex:1;min-height:0;overflow:auto;padding:var(--s3);-webkit-overflow-scrolling:touch}
.sfoot{flex:none;display:flex;gap:var(--s2);align-items:center;flex-wrap:wrap;padding:var(--s2) 12px;border-top:1px solid var(--line);background:var(--surface)}
.sfoot .grow{flex:1;min-width:140px}
.ans{font:inherit;padding:10px 12px;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:var(--r);min-width:0}
.chip.ok{background:var(--green);color:var(--on-green);border-color:var(--on-green)}
.chip.no{border-color:var(--orange);color:var(--orange);text-decoration:line-through}
.fld{margin-bottom:var(--s4)}.fld>label,.fld>.fl{display:block;font:600 14px var(--sans);margin-bottom:var(--s2)}.fld b{color:var(--blue)}
.rng{width:100%;height:36px;accent-color:var(--blue);touch-action:pan-y;margin:0}
.tk{display:flex;justify-content:space-between;font-size:12px;color:var(--muted)}
.cfg{max-width:560px;margin:0 auto}
.aud{display:flex;gap:var(--s2);flex-wrap:wrap;margin-bottom:var(--s3)}
.snt{font:400 20px/2.7 var(--serif);max-width:60ch}
.bl{width:9ch;max-width:100%;font:500 18px var(--sans);padding:2px 6px;border:0;border-bottom:2px solid var(--blue);background:var(--bg);color:var(--text);text-align:center;border-radius:0}
.bl:disabled{opacity:1}.bl.ok{border-color:#5E7A00;background:rgba(165,197,0,.25)}.bl.no{border-color:var(--orange);background:rgba(236,100,0,.12)}
.xp{display:inline-block;font:500 13px var(--sans);color:var(--orange);margin:0 6px}
.fb{min-height:24px;font-size:15px;margin-top:var(--s2)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:var(--s2);margin-bottom:var(--s4)}
.stats div{border:1px solid var(--line);padding:var(--s3);text-align:center;color:var(--muted);font-size:13px}.stats b{display:block;font:700 26px var(--serif);color:var(--wm)}
.lst{border-top:1px solid var(--line)}.lst li{padding:10px 0;border-bottom:1px solid var(--line);font-size:15px}
.vph{display:grid;place-items:center;text-align:center;gap:var(--s3);padding:var(--s4) 0}
details.d{border-top:1px solid var(--line);padding:var(--s2) 0}details.d summary{cursor:pointer;font-weight:600;min-height:32px}
/* Grammatik */
.gbody{flex:1;min-height:0;display:flex;position:relative}
.glesson{flex:1;min-width:0;overflow:auto;padding:var(--s3) var(--s4)}
.gnav,.gpanel{position:absolute;top:0;bottom:0;background:var(--surface);overflow:auto;padding:var(--s3);z-index:5;visibility:hidden;transition:transform var(--t2) var(--ease)}
.gnav{left:0;width:min(340px,92%);border-right:1px solid var(--line);transform:translateX(-100%)}
.gpanel{right:0;width:min(360px,92%);border-left:1px solid var(--line);transform:translateX(100%)}
.gnav.open,.gpanel.open{transform:none;visibility:visible}
@media(min-width:1000px){.gpanel{position:static;transform:none;visibility:visible;width:320px;flex:none}.gpx{display:none}}
.gnav details{border-bottom:1px solid var(--line)}.gnav summary{cursor:pointer;padding:10px 0;font-weight:600;font-size:15px}
.gc0{padding:10px 0;color:var(--muted);font-size:15px;border-bottom:1px solid var(--line)}
.gt{display:flex;width:100%;justify-content:space-between;gap:var(--s2);text-align:left;background:none;border:0;padding:10px 4px;font:400 15px var(--sans);color:var(--text);cursor:pointer;min-height:44px}
.gt small{color:var(--muted)}.gt[aria-current="true"]{color:var(--blue);font-weight:600}.gt:hover{background:var(--bg)}
.gtit{font:700 clamp(24px,3vw,32px)/1.15 var(--serif);color:var(--wm);margin:var(--s2) 0}
.gs{margin-top:var(--s5)}.gs h3{font:700 18px var(--serif);color:var(--wm);margin-bottom:var(--s2)}
.gs p,.gs li{max-width:68ch}.rule{border-left:3px solid var(--green);padding:var(--s2) var(--s3);background:var(--bg)}
mark{background:rgba(165,197,0,.35);color:inherit;padding:0 2px}
.ex2{padding:10px 0;border-top:1px solid var(--line)}.bad{color:var(--orange);text-decoration:line-through}.good{color:#5E7A00;font-weight:600}
:root[data-theme="dark"] .good{color:var(--green)}
.q{padding:var(--s3) 0;border-top:1px solid var(--line)}.qo,.qa{display:flex;gap:var(--s2);flex-wrap:wrap;margin-top:var(--s2)}
.tabs2{display:flex;border-bottom:1px solid var(--line);margin-bottom:var(--s3)}.tabs2 button{flex:1;background:none;border:0;border-bottom:2px solid transparent;padding:10px 4px;font:500 14px var(--sans);color:var(--text);cursor:pointer;min-height:44px}
.tabs2 [aria-selected="true"]{border-color:var(--blue);color:var(--blue);font-weight:600}
.er,.kw{border-top:1px solid var(--line);padding:var(--s3) 0}.er .badge{font-size:12px;font-weight:600;border:1px solid var(--line);padding:1px 8px;color:var(--muted)}
.kwb{margin:var(--s2) 0;transition:filter var(--t2)}.kwb.blur{filter:blur(7px);user-select:none}
/* Aussprache */
.pl{display:grid;grid-template-columns:260px minmax(0,1fr);gap:var(--s5);margin-top:var(--s4)}
.pn button{display:flex;gap:var(--s2);width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line);padding:10px 4px;font:400 15px var(--sans);color:var(--text);cursor:pointer;min-height:44px}
.pn button:disabled{color:var(--muted);cursor:not-allowed}.pn button[aria-current="true"]{color:var(--blue);font-weight:600}
.pn small{color:var(--muted);margin-left:auto;white-space:nowrap}.pnb{display:none;margin-bottom:var(--s3)}
.pr{min-width:0}.pr p,.pr li{max-width:68ch}.pr ul{list-style:disc;padding-left:var(--s4)}
.ipa{font-family:"Charis SIL","Gentium Plus","Noto Sans","DejaVu Sans",var(--sans);font-size:1.05em}
.tw{overflow-x:auto}.tw table{border-collapse:collapse;width:100%;min-width:480px;font-size:15px}.tw th,.tw td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}.tw th{font-size:13px;color:var(--muted);font-weight:600}
.cards2{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--s3)}.cards2>div{border:1px solid var(--line);padding:var(--s3)}
.big{font:400 40px/1.1 var(--serif)}
.note{border:1px dashed var(--muted);padding:var(--s3);color:var(--muted);font-size:14px;margin:var(--s3) 0}
.dec{border:1px solid var(--line);padding:var(--s3);margin-top:var(--s3)}
@media(max-width:800px){.pl{grid-template-columns:1fr}.pnb{display:inline-flex}.pn{display:none;margin-bottom:var(--s3)}.pn.open{display:block}}
@media(max-width:700px){.stg{height:calc(100dvh - 150px);min-height:420px}.wbtn{display:none}.glesson{padding:var(--s3)}.snt{font-size:19px}}
@media(pointer:coarse){.chip,.sbtn,.btn,.ans{min-height:44px}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
</style>
</head>
<body>

<!-- ===== HEADER: wie index.html (hier ohne Router/i18n; beim Zusammenführen einfach durch den echten Header ersetzen) ===== -->
