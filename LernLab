 ex:[['Ich <mark>habe</mark> gestern Pizza <mark>gegessen</mark>.','Hôm qua tôi đã ăn pizza.'],['Wir <mark>sind</mark> nach Hanoi <mark>gefahren</mark>.','Chúng tôi đã đi Hà Nội.'],['Sie <mark>hat</mark> ihre Oma <mark>besucht</mark>.','Cô ấy đã thăm bà.']],
 exc:'Verben auf -ieren und untrennbare Präfixe (be-, ge-, er-, ver-, zer-, ent-) bilden das Partizip ohne ge-: studiert, erzählt.',
 err:[['Ich habe gestern ins Kino gehen.','Ich bin gestern ins Kino gegangen.','gehen braucht sein und das Partizip II gegangen.'],['Ich habe gegangen.','Ich bin gegangen.','Bewegungsverben bilden das Perfekt mit sein.']],
 q:[{id:'q1',t:'mc',q:'Wir ___ gestern nach Hanoi gefahren.',o:['haben','sind','werden'],a:1,w:'fahren drückt Bewegung aus und bildet das Perfekt mit sein.'},
 {id:'q2',t:'fill',q:'Sie hat das Buch ___ . (lesen)',a:'gelesen',w:'lesen ist unregelmäßig: ge-les-en.'},
 {id:'q3',t:'fill',q:'Er ist früh ___ . (aufstehen)',a:'aufgestanden',w:'trennbar: auf + ge + standen.'}]}};
var REF={perfekt:{q:'Wie bildet man das Perfekt?',a:'haben/sein (Position 2) + Partizip II (Satzende)',m:'regelmäßig ge-…-t · unregelmäßig ge-…-en · sein bei Bewegung und Zustandswechsel',e:'Ich bin gestern ins Kino gegangen.'},
 dativ:{q:'Wie lauten die Artikel im Dativ?',a:'dem (m) · der (f) · dem (n) · den + -n (Plural)',m:'Nach aus, bei, mit, nach, seit, von, zu steht immer der Dativ.',e:'Ich helfe dem Mann.'},
 verbzweitstellung:{q:'Wo steht das finite Verb im Aussagesatz?',a:'Immer auf Position 2.',m:'Auf Position 1 kann Subjekt oder ein anderes Satzglied stehen (Inversion).',e:'Heute gehe ich ins Kino.'}};
var G={lvl:1,q:'',cur:'perfekt',play:false,tab:'a',open:{},recent:[],rv:{}},errs=ls('ll-gerr',[]),prog=ls('ll-gprog',{});
function gVis(t){return t.l<=G.lvl}
function gNavInit(){$('#gNav').innerHTML='<div class="fgroup" role="group" aria-label="Niveau, kumulativ">'+LV.map(function(x,i){return'<button class="chip" type="button" data-gl="'+i+'" aria-pressed="'+(i===G.lvl)+'">'+x+'</button>'}).join('')+'</div><p class="muted sm" id="gLn" style="margin:8px 0"></p><input class="ans" id="gQ" type="search" style="width:100%;margin-bottom:8px" placeholder="Thema suchen (DE, VI, EN)" aria-label="Thema suchen"><div id="gList"></div>';gList()}
function gList(){var q=G.q.trim().toLowerCase(),h='';$('#gLn').textContent='Zeigt A1 bis '+LV[G.lvl];
  CATS.forEach(function(cn,c){var ts=TP.filter(function(t){return t.c===c&&gVis(t)&&(!q||(t.de+' '+t.vi+' '+t.en+' '+cn).toLowerCase().indexOf(q)>=0)});
    if(!ts.length){h+='<p class="gc0">'+esc(cn)+' (0)</p>';return}
    h+='<details data-c="'+c+'"'+((q||G.open[c])?' open':'')+'><summary>'+esc(cn)+' ('+ts.length+')</summary>'+ts.map(function(t){var d=(prog[t.id]&&LES[t.id]&&Object.keys(prog[t.id]).length>=LES[t.id].q.length);return'<button class="gt" type="button" data-t="'+t.id+'"'+(t.id===G.cur?' aria-current="true"':'')+'><span>'+esc(t.de)+(d?' ✓':'')+'<br><small>'+esc(t.vi)+'</small></span><small>'+LV[t.l]+'</small></button>'}).join('')+'</details>'});
  $('#gList').innerHTML=h;$$('#gList details').forEach(function(d){d.addEventListener('toggle',function(){G.open[d.dataset.c]=d.open})})}
function gProg(){var L=LES[G.cur],n=L?L.q.length:0,d=L&&prog[G.cur]?Object.keys(prog[G.cur]).length:0;$('#gP').style.width=(n?d/n*100:0)+'%'}
function gLes(){var t=TP.find(function(x){return x.id===G.cur}),L=LES[t.id],el=$('#gLes');$('#gT').textContent=t.de;$('#gLv').textContent=LV[t.l];
  var h='<p class="muted sm">'+esc(CATS[t.c])+' · '+['Leicht','Mittel','Schwer'][t.l>>1]+' · '+esc(t.vi)+'</p><h2 class="gtit">'+esc(t.de)+'</h2>';
  if(G.play){el.innerHTML=h+'<div class="note">Play-Modus: Bald. Es gibt hier noch kein Spiel.</div>';return gProg()}
  if(!L){el.innerHTML=h+'<div class="note">Die Lektion zu diesem Thema ist noch in Vorbereitung. Verfügbar ist bisher: <button class="link" type="button" data-t="perfekt" style="background:none;border:0;cursor:pointer;padding:0">Perfekt</button>.</div>';return gProg()}
  el.innerHTML=h+'<div class="gs"><h3>Lernziel</h3><p>'+L.goal+'</p></div><div class="gs"><h3>Erklärung</h3><p>'+L.expl+'</p></div><div class="gs"><h3>Regeln und Bildung</h3><p class="rule">'+L.rule+'</p></div>'+
   '<div class="gs"><h3>Beispiele</h3>'+L.ex.map(function(x){return'<div class="ex2"><p>'+x[0]+'</p><p class="muted sm">'+x[1]+'</p></div>'}).join('')+'</div>'+
   '<div class="gs"><h3>Besonderheiten</h3><p>'+L.exc+'</p></div><div class="gs"><h3>Häufige Fehler</h3>'+L.err.map(function(x){return'<div class="ex2"><p class="bad">'+x[0]+'</p><p class="good">'+x[1]+'</p><p class="muted sm">'+x[2]+'</p></div>'}).join('')+'</div><div class="gs"><h3>Übung</h3><div id="gQz"></div></div>';
  quiz($('#gQz'),L.q,gAns);gProg()}
function gAns(q,ok,given){var t=TP.find(function(x){return x.id===G.cur}),id=G.cur+':'+q.id,e=errs.find(function(x){return x.id===id}),cor=q.t==='fill'?q.a:q.o[q.a];
  if(!ok){if(e){e.tries++;e.wrong=given;e.fixed=0}else errs.push({id:id,topic:G.cur,ex:q.id,lvl:LV[t.l],wrong:given,correct:cor,wrongSent:q.q.replace('___',given),sent:q.q.replace('___',cor),why:q.w,ts:Date.now(),tries:1,fixed:0,saved:0})}
  else{var p=prog[G.cur]=prog[G.cur]||{};p[q.id]=1;sv('ll-gprog',prog);if(e)e.fixed=1}
  sv('ll-gerr',errs);gProg();if(G.tab==='a')gPan()}
function gPan(){var el=$('#gPanC'),h='';$('#gTa').setAttribute('aria-selected',G.tab==='a');$('#gTb').setAttribute('aria-selected',G.tab==='b');
  if(G.tab==='a'){if(!errs.length)h='<p><b>Noch keine Fehler!</b></p><p class="muted">Deine Grammatikkenntnisse entwickeln sich. Hier erscheinen deine Fehler, sobald du Übungen bearbeitest.</p>';
    else h=errs.slice().reverse().map(function(e){var b=e.saved?'Gespeichert':e.fixed?'Richtig nach Wiederholung':e.tries>1?'Wiederholter Fehler':'Erster Fehler';
      return'<div class="er"><p><span class="badge">'+b+'</span> <span class="muted sm">'+e.lvl+' · '+e.tries+'× falsch</span></p><p class="bad">'+esc(e.wrongSent)+'</p><p class="good">'+esc(e.sent)+'</p><p class="sm">'+esc(e.why)+'</p><div class="qa"><button class="chip" type="button" data-sv="'+e.id+'"'+(e.saved?' disabled':'')+'>'+(e.saved?'In LernLib gespeichert':'In meine LernLib speichern')+'</button><button class="chip" type="button" data-t="'+e.topic+'">Zur Lektion</button></div></div>'}).join('')}
  else{var ids=[G.cur].concat(G.recent).filter(function(x,i,a){return REF[x]&&a.indexOf(x)===i});Object.keys(REF).forEach(function(k){if(ids.indexOf(k)<0)ids.push(k)});
    ids=ids.filter(function(k){var t=TP.find(function(x){return x.id===k});return t&&gVis(t)});
    h=ids.length?ids.map(function(k){var r=REF[k],t=TP.find(function(x){return x.id===k}),on=G.rv[k];return'<div class="kw"><b>'+esc(t.de)+'</b><p>'+r.q+'</p><div class="kwb'+(on?'':' blur')+'" id="kw-'+k+'"><p><b>'+r.a+'</b></p><p class="sm">'+r.m+'</p><p class="sm"><i>'+r.e+'</i></p></div><button class="chip" type="button" data-rv="'+k+'" aria-expanded="'+!!on+'" aria-controls="kw-'+k+'">'+(on?'Verbergen':'Wissen aufdecken')+'</button></div>'}).join(''):'<p class="muted">Für dieses Niveau gibt es noch keine Wissenskarten.</p>'}
  el.innerHTML=h}
function gOpen(id){G.cur=id;G.recent=[id].concat(G.recent.filter(function(x){return x!==id})).slice(0,5);G.play=false;$('#gPlayB').setAttribute('aria-pressed','false');
  $('#gNav').classList.remove('open');$('#gNavB').setAttribute('aria-expanded','false');gList();gLes();gPan();$('#gLes').scrollTop=0}
$('#gNavB').onclick=function(){var o=$('#gNav').classList.toggle('open');this.setAttribute('aria-expanded',o)};
$('#gPanB').onclick=function(){var o=$('#gPan').classList.toggle('open');this.setAttribute('aria-expanded',o)};
$('#gPlayB').onclick=function(){G.play=!G.play;this.setAttribute('aria-pressed',G.play);gLes()};
$('#gTa').onclick=function(){G.tab='a';gPan()};$('#gTb').onclick=function(){G.tab='b';gPan()};
$('#gNav').addEventListener('input',function(e){if(e.target.id==='gQ'){G.q=e.target.value;gList()}});
$('#gStage').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;
  if(b.dataset.gl){G.lvl=+b.dataset.gl;$$('[data-gl]').forEach(function(x){x.setAttribute('aria-pressed',x===b)});gList();gPan()}
  if(b.dataset.t)gOpen(b.dataset.t);
  if(b.dataset.rv){G.rv[b.dataset.rv]=!G.rv[b.dataset.rv];gPan()}
  if(b.dataset.sv){var x=errs.find(function(q){return q.id===b.dataset.sv});if(x){toLib({k:'gram:'+x.id,src:'Grammatik',topic:x.topic,wrong:x.wrongSent,correct:x.sent,why:x.why,level:x.lvl,ts:Date.now()});x.saved=1;sv('ll-gerr',errs);gPan()}}});
gNavInit();gLes();gPan();

