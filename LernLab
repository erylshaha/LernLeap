function segs(it){if(D.mode==='whole')return[{t:it.plain}];var o=[],cur='';it.parts.forEach(function(p){if(p.b){if(cur.trim())o.push({t:cur.trim()});cur='';if(o.length)o.push({pause:900})}else cur+=p.w});if(cur.trim())o.push({t:cur.trim()});return o}
function dStart(){var per=D.diff+2,left=D.n,items=[];
  pool().map(function(s){return{s:s,k:Math.abs(s.d-D.diff-1)+Math.random()*.9}}).sort(function(a,b){return a.k-b.k}).forEach(function(o){if(left<=0)return;var s=o.s,take=Math.min(left,per,s.c),idx=[],ci=0,parts=[],plain='';
    for(var i=0;i<s.c;i++)idx.push(i);idx.sort(function(){return Math.random()-.5});var pick=idx.slice(0,take);
    s.t.split(/(\[[^\]]+\])/).forEach(function(tk){if(!tk)return;if(tk[0]==='['){var w=tk.slice(1,-1);parts.push(pick.indexOf(ci)>=0?{b:1,e:w}:{w:w});plain+=w;ci++}else{parts.push({w:tk});plain+=tk}});
    items.push({parts:parts,plain:plain});left-=take});
  items.sort(function(){return Math.random()-.5});S={items:items,i:0,ans:[],checked:false};dPlay()}
