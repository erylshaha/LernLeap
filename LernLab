  el.innerHTML=qs.map(function(q,i){return '<div class="q" data-i="'+i+'"><p><b>'+(i+1)+'.</b> '+q.q+'</p>'+(q.t==='fill'?'<div class="qa"><input class="ans" aria-label="Antwort '+(i+1)+'" autocomplete="off" autocapitalize="off" spellcheck="false"><button class="chip" type="button" data-k="1">Prüfen</button></div>':'<div class="qo">'+q.o.map(function(o,j){return '<button class="chip'+(q.ipa?' ipa':'')+'" type="button" data-j="'+j+'">'+esc(o)+'</button>'}).join('')+'</div>')+'<p class="fb" role="status" aria-live="polite"></p></div>'}).join('');
  function ans(box,given,ok){var i=+box.dataset.i,q=qs[i];tr[i]=(tr[i]||0)+1;var fb=$('.fb',box);
    if(ok){fb.textContent='✓ Richtig. '+(q.w||'');box.dataset.done=1;$$('.chip,.ans',box).forEach(function(x){x.disabled=true})}else fb.textContent='✗ Noch nicht. '+(q.w||'')+' Versuche es noch einmal.';
    cb(q,ok,given,tr[i])}
  el.onclick=function(e){var b=e.target.closest('button');if(!b)return;var box=b.closest('.q');if(!box||box.dataset.done)return;var q=qs[+box.dataset.i];
    if(b.dataset.j!==undefined){var j=+b.dataset.j,ok=j===q.a;b.classList.add(ok?'ok':'no');ans(box,q.o[j],ok)}
    else if(b.dataset.k){var v=$('.ans',box).value;if(!v.trim())return;ans(box,v.trim(),norm(v).toLowerCase()===q.a.toLowerCase())}};
  el.onkeydown=function(e){if(e.key==='Enter'&&e.target.classList&&e.target.classList.contains('ans')){e.preventDefault();var b=$('[data-k]',e.target.closest('.q'));b&&b.click()}}}
function toLib(item){var lib=ls('ll-lib',[]);if(lib.some(function(x){return x.k===item.k}))return 0;lib.push(item);sv('ll-lib',lib);return 1}

